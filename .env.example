# Airtable — get these from airtable.com/account (Personal Access Token)
# and your base URL (the app... ID in the browser when viewing the base).
# Without these, the site falls back to the local data/catalogue.ts file.
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE=Table 1
# Optional: defaults to "Catalogue". Change to match your table name.
# AIRTABLE_TABLE=Catalogue
